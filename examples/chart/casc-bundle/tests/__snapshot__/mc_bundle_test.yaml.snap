renders the full MC bundle snapshot:
  1: |
    apiVersion: v1
    data:
      bundle.yaml: |
        apiVersion: "2"
        version: "1"
        id: "RELEASE-NAME"
        description: "Managed controller bundle"
        plugins:
          - plugins-mc.yaml
        items:
          - items-platform.yaml
          - items-card-banking.yaml
      items-card-banking.yaml: |
        removeStrategy:
          items: NONE

        items:
        - kind: folder
          name: card-banking
          displayName: "Card Banking"
          description: "Folder for Card Banking team"
          items:
          - kind: pipeline
            name: card-banking-build
            displayName: "Card Banking build"
            description: "Main build pipeline for Card Banking"
      items-platform.yaml: |
        removeStrategy:
          items: NONE

        items:
        - kind: folder
          name: platform
          displayName: "Platform"
          description: "Folder for Platform team"
          items:
          - kind: pipeline
            name: platform-build
            displayName: "Platform build"
            description: "Main build pipeline for Platform"
      plugins-mc.yaml: |
        plugins:
          - id: cloudbees-casc-client
          - id: cloudbees-rbac-plugin
    kind: ConfigMap
    metadata:
      annotations:
        argocd.argoproj.io/sync-options: ServerSideApply=true
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: casc-bundle
        helm.sh/chart: casc-bundle-0.1.0
      name: RELEASE-NAME
