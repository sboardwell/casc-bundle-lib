renders the full OC bundle snapshot:
  1: |
    apiVersion: v1
    data:
      bundle.yaml: |
        apiVersion: "2"
        version: "1"
        id: "RELEASE-NAME"
        description: "Operations Center bundle"
        jcasc:
          - jenkins.yaml
        plugins:
          - plugins-oc.yaml
      jenkins.yaml: |
        jenkins:
          systemMessage: "CloudBees CI Operations Center"
          numExecutors: 0
          mode: EXCLUSIVE
          authorizationStrategy: "cloudBeesRoleBasedAccessControl"

        unclassified:
          location:
            adminAddress: "admin@example.com"
          bundleUpdateTiming:
            automaticReload: true
            automaticRestart: false
            rejectWarnings: true
            reloadAlwaysOnRestart: true
            skipNewVersions: false
          cascAutoControllerProvisioning:
            duration: 60
            fireAndForget: true
            initialDelay: 15
            provisionControllerOnCreation: true
            timeout: 600
      plugins-oc.yaml: |
        plugins:
          - id: cloudbees-casc-server
          - id: operations-center-cloud
          - id: operations-center-rbac
    kind: ConfigMap
    metadata:
      annotations:
        argocd.argoproj.io/sync-options: ServerSideApply=true
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: casc-bundle
        helm.sh/chart: casc-bundle-0.1.0
      name: RELEASE-NAME
